# Copy to backend/.env for local development. NEVER commit the real .env.
APP_ENV=development                 # production = strict checks (see core/config.py)

# PostgreSQL. Works with the docker-compose db. Hosted free tiers usually need ?sslmode=require
DATABASE_URL=postgresql://airq:airq@127.0.0.1:5432/airq
AUTO_CREATE_TABLES=true             # creates missing tables on startup (Alembic comes in Phase 5)

# Auth. Production REQUIRES a random value of 32+ chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MIN=60
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# ALLOWED_ORIGINS: comma-separated, explicit origins only. COOKIE_SECURE blank = false in dev, true in production.
# COOKIE_SAMESITE: lax | strict | none (none needs HTTPS + COOKIE_SECURE=true). COOKIE_DOMAIN blank = host-only cookie.

# Request limits (replace the old plan tiers)
MAX_DAYS=90
MAX_CITIES_PER_REQUEST=10

# Data. Open-Meteo (model estimate, free, NON-COMMERCIAL use only) works with no key.
# OpenAQ v3 (ground stations, CPCB data) needs a free key: register at https://explore.openaq.org
OPENAQ_API_KEY=
AUTO_SEED_PLACES=true               # load the India places catalogue on first start
STATION_RADIUS_M=25000              # nearest station search radius (OpenAQ max is 25 km)
STATION_MAX_AGE_DAYS=30             # ignore stations with no data for this long
STALE_AFTER_HOURS=3                 # live reading older than this is flagged stale
MODEL_CACHE_HOURS=6                 # old SARIMAX endpoints only (removed in a later phase)

# Optional AI agent - added at the end of the project
AGENT_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
